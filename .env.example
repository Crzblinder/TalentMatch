# ============================================================
#  TalentMatch Engine 环境变量配置模板
#  使用方法：复制本文件为 .env，根据实际情况取消对应注释
#  cp .env.example .env
# ============================================================


# ====================== 通用参数 ======================
# 以下参数在"路线 A"和"路线 B"中均需配置

# -- 数据库 --
# Docker 环境使用 MySQL；本地快速启动可改用 SQLite
DATABASE_URL=mysql+pymysql://talentmatch:talentmatch@mysql:3306/talentmatch?charset=utf8mb4
DATABASE_URL_SQLITE=sqlite:///./talentmatch.db

# -- 向量库 --
VECTOR_DB_PATH=./chroma_data
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 镜像源（中国大陆网络建议开启，首次下载模型更快）
# 可选值：https://hf-mirror.com（默认镜像）或你自己的代理地址
# HF_ENDPOINT=https://hf-mirror.com

# -- 应用 --
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# -- 前端 --
VITE_API_BASE_URL=http://localhost:8000


# ===========================================================
#  大模型运行模式 —— 请二选一
#  核心开关：USE_LOCAL_LLM
#    false（默认）→ 路线 A：云端 API 模式
#    true         → 路线 B：本地 Ollama 模式（零成本免密）
# ===========================================================

# 默认使用云端 API；如需本地运行，取消下面这行的注释并设为 true
# USE_LOCAL_LLM=false


# ===================== 路线 A：云端 API 模式 =====================
# 适用场景：有 OpenAI / 第三方兼容 API Key，追求最高推理质量
# 操作步骤：
#   1. 确保 USE_LOCAL_LLM=false（或不设置）
#   2. 填入你的 API Key
#   3. 运行 docker compose up --build -d

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 提示：OPENAI_API_KEY 留空时，系统仍可通过内置规则引擎正常运行（确定性降级）。


# ===================== 路线 B：本地 Ollama 模式 =====================
# 适用场景：无 API Key、内网环境、希望零成本运行
# 操作步骤：
#   1. 取消 USE_LOCAL_LLM=true 的注释
#   2. 确认 Ollama 服务地址（Docker 内部默认 http://ollama:11434）
#   3. 运行 make docker-up-ollama（自动拉取中文模型）
#
# 推荐模型：qwen2.5:7b（中文能力强，7B 参数量适合消费级 GPU）
# 更多模型：https://ollama.com/library

# USE_LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b


# ===========================================================
#  国产 LLM 配置（可选）
#  接入阿里云百炼 DashScope / 智谱 Zhipu 的 OpenAI-compatible 接口
#  优先级：DashScope > Zhipu > 原有 OpenAI-compatible
# ===========================================================

# USE_DOMESTIC_LLM=false
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-max
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 通用多模态模型（默认 gpt-4o；非国产模式或部分 JD 服务直接使用）
# MULTIMODAL_MODEL=gpt-4o

# 国产多模态模型（use_domestic_llm=true 时，LLM 工厂优先使用）
# DOMESTIC_MULTIMODAL_MODEL=qwen-vl-max

# 文档解析 / OCR 模型（use_domestic_llm=true 时，PDF/DOCX 优先走云端解析）
# DASHSCOPE_DOC_PARSE_MODEL=qwen-vl-max


# ===========================================================
#  联网搜索配置（可选）
#  优先级：Bocha > 智谱 > SearXNG > Tavily > DuckDuckGo
#  未配置或失败时自动降级到下一源
# ===========================================================

# 博查 AI 搜索 API Key（国内稳定，申请地址：https://open.bochaai.com）
# BOCHA_API_KEY=

# 智谱 AI 搜索（复用 ZHIPU_API_KEY，模型使用 glm-4-search）
# ZHIPU_API_KEY=

# 本地 SearXNG 地址（默认 http://localhost:8080）
# SEARXNG_BASE_URL=http://localhost:8080

# Tavily 搜索 API Key（可选，国外服务）
# TAVILY_API_KEY=

# DuckDuckGo 搜索无需配置，默认作为最终兜底


# ===========================================================
#  国内招聘平台抓取（可选，默认关闭）
#  开启后会使用 Playwright 抓取 Boss 直聘 / 智联招聘公开列表页
#  作为 RSS/种子数据的补充；未安装 Playwright 时自动降级为空列表
# ===========================================================

# 国内平台抓取总开关
# DOMESTIC_CRAWLER_ENABLED=false

# Playwright 是否以无头模式运行
# PLAYWRIGHT_HEADLESS=true

# 页面操作间隔（毫秒），适当增大可降低反爬概率
# DOMESTIC_CRAWLER_DELAY_MS=1000


# ===========================================================
#  内容安全（阿里云绿网/内容安全）与数据脱敏
# ===========================================================

# 内容安全总开关
# ENABLE_CONTENT_SAFETY=false

# 阿里云 AccessKey（启用内容安全时必须配置）
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 阿里云内容安全 endpoint
# CONTENT_SAFETY_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com

# 简历数据脱敏总开关
# ENABLE_RESUME_MASKING=false
